#!/usr/bin/env python3
"""Atrapa `claude -p` do testów: czeka FAKE_DELAY s i zwraca deterministyczny JSON.
FAKE_LOG=plik -> dopisuje tam pełny prompt (do sprawdzania, co dostaje model).
Dodatki, wyłączone, dopóki nie ustawi się zmiennej (stare testy ich nie widzą):
FAKE_PLAN_FILE=plik -> jeśli plik istnieje, plan tygodnia ma nazwy dań z tego pliku (lista JSON) zamiast "Szkic 1..9".
FAKE_TR=1 -> prompt tłumaczenia dostaje prawdziwą odpowiedź (każdy tekst z przedrostkiem "PL ").
FAKE_TIMES=plik -> po każdym wywołaniu dopisuje wiersz "rodzaj początek koniec" (do liczenia równoległości).
Prompt z "price_pick" (wybór produktu do ceny) dostaje drugi produkt z listy każdego składnika.
FAKE_FAIL_FILE=plik -> jeśli plik istnieje, a prompt zawiera jego treść, atrapa kończy się błędem (model zawiódł).
Bilans talerza: przepis na danie z "Soppstroganoff" lub "Uforbederlig" w nazwie nie ma białka, z "Risotto" ma go mało,
z "Linsegryte" jest w porządku; prompt poprawki ("nie spełnia bilansu talerza") dokłada fasolę (poza "Uforbederlig").
Prompt dopasowania gazetek ("offer_match") dostaje pary wyliczone prostą regułą wspólnych słów,
prompt odczytu gazetki KIWI ("leaflet_offers") kilka stałych ofert."""
import json, os, re, sys, time
t0 = time.time()
p = sys.stdin.read()
if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write(p + "\n=====\n")
fail_file = os.environ.get("FAKE_FAIL_FILE")
if fail_file and os.path.exists(fail_file) and open(fail_file).read().strip() in p:
    sys.exit("atrapa: zamówiony błąd modelu")
time.sleep(float(os.environ.get("FAKE_DELAY", "2")))
ing = ["a", "b", "c", "d", "e", "f"]
plan_file = os.environ.get("FAKE_PLAN_FILE")
if os.environ.get("FAKE_TR") == "1" and p.startswith("Przetłumacz poniższe dania"):
    kind = "tr"
    todo = json.loads(re.search(r"^Dane: (.*)$", p, re.M).group(1))
    out = {"meals": [{"i": m["i"], "name": "PL " + m["name"], "description": "PL " + m["description"],
                      "ingredients": ["PL " + x for x in m["ingredients"]], "steps": ["PL " + x for x in m["steps"]]}
                     for m in todo]}
elif '"leaflet_offers"' in p:
    kind = "leaflet"
    # odczyt gazetki KIWI: stałe oferty dla stron, na których są te nazwy; KINAKÅL celowo ze złym rachunkiem
    # (16,90 za 500 g to nie 99,00/kg), żeby było widać, że serwer taką ofertę ukrywa
    fixed = [("GULROT", {"info": "750 g, Gartner", "price": 19.90, "per": "stk", "unit_price": 26.53, "unit": "kg"}),
             ("PURRE", {"info": "Gartner", "price": 27.90, "per": "kg"}),
             ("KÅLROT", {"info": "Gartner", "price": 9.90, "per": "kg", "member": True}),
             ("KINAKÅL", {"info": "500 g, Gartner", "price": 16.90, "per": "stk", "unit_price": 99.00, "unit": "kg"})]
    out = {"leaflet_offers": [{"page": 3, "name": n, **o} for n, o in fixed if "| " + n + "\n" in p]}
elif '"offer_match"' in p:
    kind = "offers"
    # gazetki: para, gdy wszystkie słowa pozycji listy są całymi słowami w nazwie produktu (albo tytule) oferty.
    # Celowo naiwne: „ingefær” trafia też w „Syltet Ingefær”, żeby było widać, że serwer taką parę odrzuca.
    def words(x):
        x = x.lower().replace("ø", "o").replace("æ", "ae").replace("å", "a")
        return re.sub(r"[^a-z0-9]+", " ", x).split()
    items = re.findall(r"^(\d+): (.*) \[([^\]]*)\]$", p[p.index("Pozycje ("):p.index("Oferty (")], re.M)
    offers = re.findall(r"^(\d+): (.*)$", p[p.index("Oferty ("):p.index("Zwróć wyłącznie JSON")], re.M)
    pairs = []
    for i, name, aisle in items:
        iw = set(words(name))
        for o, line in offers:
            title, _, plist = line.partition(" | ")
            prods = re.split(r";\s+(?=\d+\) )", plist) if plist else []
            hit = [int(x.split(") ", 1)[0]) for x in prods if iw <= set(words(x.split(") ", 1)[1]))]
            if hit or (not prods and iw <= set(words(title))):
                # dział: jak pozycja, poza wędliną z czosnkiem w nazwie (serwer ma taką parę odrzucić po dziale)
                pairs.append({"item": int(i), "offer": int(o), "products": hit, "kind": title.lower(), "flavour": False,
                              "aisle": "Kjøtt og fisk" if "svinekam" in line.lower() else aisle if aisle != "Moje produkty" else "Annet"})
    out = {"offer_match": pairs}
elif '"price_pick"' in p:
    kind = "price"
    # drugi kandydat, gdy jest (widać, że wybór modelu wygrywa z rankingiem); 'zzbrak' = żaden produkt nie pasuje
    todo = json.loads(re.search(r"^Dane: (.*)$", p, re.M).group(1))
    out = {"price_pick": {x["ingredient"]: -1 if "zzbrak" in x["ingredient"] else min(1, len(x["products"]) - 1) for x in todo}}
elif '"aisle_of"' in p:
    kind = "aisle"
    out = {"aisle_of": "Annet" if "zzannet" in p else "Frys"}
elif '"options"' in p:
    kind = "options"
    # pierwsza propozycja celowo = danie z listy 👎 (serwer ma ją odfiltrować)
    out = {"options": [{"name": "Szkic 2", "description": "zablokowane?", "is_fish": False, "ingredients": ing}] +
                      [{"name": f"Alt {i+1} testowy", "description": "opis testowy", "is_fish": False, "ingredients": ing} for i in range(3)]}
elif "nie spełnia bilansu talerza" in p:
    kind = "fix"
    # poprawka bilansu: przepis z promptu + fasola. Danie z "Uforbederlig" w nazwie wraca bez zmian (model nie pomógł).
    m = json.loads(p[p.index("Przepis:\n") + 9:])
    if "Uforbederlig" not in m["name"]:
        m["ingredients"].append({"name": "hvite bønner", "qty": 800, "unit": "g", "aisle": "Tørrvarer og hermetikk", "from_pantry": False})
        m["steps"].append("ha i bønnene")
        m["description"] = "med hvite bønner"
    out = {"meal": m}
elif '"meal": {' in p and re.search(r"Napisz pełny przepis na danie: [^\n]*(Soppstroganoff|Uforbederlig|Risotto|Linsegryte)", p):
    kind = "meal"
    # dania do testów bilansu: bez białka (Soppstroganoff, Uforbederlig), z małą ilością (Risotto), w porządku (Linsegryte)
    nm = re.search(r"Napisz pełny przepis na danie: (.*?) \(", p).group(1)
    I = lambda n, q, u, a="Frukt og grønt": {"name": n, "qty": q, "unit": u, "aisle": a, "from_pantry": False}
    base = [I("løk", 2, "stk"), I("gulrot", 2, "stk"), I("ris", 225, "g", "Tørrvarer og hermetikk")]
    extra = ([I("røde linser", 300, "g", "Tørrvarer og hermetikk"), I("hakkede tomater", 400, "g", "Tørrvarer og hermetikk")] if "Linsegryte" in nm
             else [I("sjampinjong", 300, "g"), I("grana padano", 40, "g", "Meieri og kjøl")] if "Risotto" in nm
             else [I("sjampinjong", 400, "g"), I("rømme", 3, "dl", "Meieri og kjøl")])
    out = {"meal": {"name": nm, "time_min": 30, "description": "d", "is_fish": False, "ingredients": base + extra,
                    "steps": ["krok 1", "krok 2"]}}
elif '"meal": {' in p:
    kind = "meal"
    out = {"meal": {"name": "Test", "time_min": 30, "description": "d", "is_fish": False,
                    "ingredients": [{"name": "gulrot", "qty": 2, "unit": "stk", "aisle": "Frukt og grønt", "from_pantry": False}],
                    "steps": ["krok 1", "krok 2"]}}
else:
    kind = "plan"
    # 9 propozycji (serwer prosi o 7+2), w tym "Szkic 2" - jeśli jest na liście 👎, ma wypaść
    names = [f"Szkic {i+1}" for i in range(9)]
    if plan_file and os.path.exists(plan_file):
        names = json.load(open(plan_file))
    out = {"meals": [{"name": n, "description": "d", "is_fish": False, "ingredients": ing} for n in names]}
if os.environ.get("FAKE_TIMES"):
    with open(os.environ["FAKE_TIMES"], "a") as f:
        f.write(f"{kind} {t0:.3f} {time.time():.3f}\n")
print(json.dumps(out))
